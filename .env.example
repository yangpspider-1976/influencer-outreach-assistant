# ---------------------------------------------------------------------------
# QROAD Influencer Outreach Assistant - environment configuration template
# Copy to `.env` and fill in real values. NEVER commit a populated .env (SEC-009).
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://qroad:qroad_dev_password@localhost:5433/qroad_ioa?schema=public"

# Secret used to sign session cookies. Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-value-at-least-32-chars"

# Private object storage root for uploaded source files and generated exports.
# Files here are never served directly; they are streamed through authorized routes only (SEC-008).
STORAGE_DIR="./.storage"

# Serverless hosts (e.g. Vercel) have a read-only filesystem, so set this to a
# Vercel Blob read-write token to store uploads/exports there instead of on disk.
# Create one under Vercel → Storage → Blob. Leave empty to use STORAGE_DIR.
BLOB_READ_WRITE_TOKEN=""

# One-time production bootstrap (npm run db:bootstrap) — creates the roles and a
# single administrator so an empty production database can be signed into. Not
# used at runtime; safe to leave empty except when running the bootstrap.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# Session inactivity timeout in minutes (SEC-011).
SESSION_IDLE_TIMEOUT_MINUTES="60"

# Maximum accepted import file size in megabytes (FR-007 / SEC-005).
MAX_UPLOAD_MB="10"

# Maximum accepted data row count per import file (SEC-005).
MAX_IMPORT_ROWS="5000"

# Optional: comma-separated list of email domains allowed to hold accounts.
# Leave empty to allow any domain.
ALLOWED_EMAIL_DOMAINS=""

# Row threshold above which an export is processed as a background job (§18).
EXPORT_SYNC_ROW_LIMIT="5000"

# ---------------------------------------------------------------------------
# Creator discovery — automatic web-search provider (optional).
#
# Without any key, discovery still works via the free guided browser search
# (open a search, copy the profile links you want, import them). Adding a key
# makes the "Search automatically" button return reviewable profile URLs.
# Discovery only ever reads a web-search index for PUBLIC profile links — it
# never signs in to, scrapes, or collects follower/contact data from Meta.
#
# Which provider to use (auto | serper | google | brave | off). "auto" uses
# whichever key below is present (Serper first, then Google, then Brave).
DISCOVERY_PROVIDER="auto"

# Option A — Serper (recommended: simplest setup, real Google results).
#   One key, no separate engine id, ~2,500 free searches. Sign up at
#   https://serper.dev/ and paste the API key here.
SERPER_API_KEY=""

# Option B — Google Programmable Search (free 100 searches/day).
#   1. Create an API key:  https://console.cloud.google.com/apis/credentials
#      (enable the "Custom Search API" for the project)
#   2. Create a search engine: https://programmablesearchengine.google.com/
#      set it to "Search the entire web", then copy its Search engine ID.
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_ID=""

# Option C — Brave Search API (free developer tier).
#   Get a key at https://api-dashboard.search.brave.com/ and paste it here.
BRAVE_SEARCH_API_KEY=""

# Two-letter country used to improve discovery relevance (default: Philippines).
DISCOVERY_SEARCH_COUNTRY="ph"

# Allows the administrator "reset and reseed demo data" action to run even when
# NODE_ENV=production. Leave unset (or false) everywhere that holds real data.
# Only ever enable this on a disposable demo or staging environment.
ALLOW_DEMO_RESET=""

# Development only: extra hosts allowed to load the dev server over the LAN
# (comma-separated). The common private ranges 192.168.*.*, 10.*.*.* and
# 172.16.*.* are already allowed in next.config.ts; set this only if your
# network uses a different subnet or you want to allow a hostname.
DEV_ALLOWED_ORIGINS=""
